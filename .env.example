# Supabase
# SUPABASE_SECRET_KEY is server-only and required for XP writes, quiz state,
# editorial workflows and other privileged operations. Never prefix it with
# NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: grounded AI assistant (OpenAI-compatible). Dua pemasangan yang
# didukung — pilih salah satu:
#   (a) Z.ai GLM:     ZAI_API_KEY / ZAI_API_BASE / ZAI_MODEL
#   (b) Kustom/umum:  AI_API_KEY  / AI_BASE_URL  / AI_MODEL
# Semua hanya dibaca di server (route /api/v1/ai/ask). Contoh kustom:
# AI_API_KEY=your_server_side_key
# AI_BASE_URL=https://api.provider.com/v1
# AI_MODEL=model-name
# ZAI_API_KEY=your_server_side_key
# ZAI_API_BASE=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4-flash

# Optional: transactional email (Resend)
# Optional error reporting webhook (Sentry proxy, Better Stack, etc.)
# ERROR_WEBHOOK_URL=https://example.com/errors

# RESEND_API_KEY=your_server_side_key
# EMAIL_FROM=LokaQuest <noreply@your-domain>
